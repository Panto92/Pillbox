// Pillbox fastfetch config – muted, compact
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": { "1": "38;2;127;151;166" },
    "padding": { "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;127;151;166", "title": "38;2;205;213;219" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "de",
    "wm",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "uptime"
  ]
}
