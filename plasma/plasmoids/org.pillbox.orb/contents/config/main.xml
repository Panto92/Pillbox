<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="orbX" type="Int"><default>-1</default></entry>
    <entry name="orbY" type="Int"><default>-1</default></entry>
    <entry name="locked" type="Bool"><default>false</default></entry>
    <!-- apps pinned to the ring; the defaults only use apps every Plasma install has -->
    <entry name="launchers" type="StringList">
      <default>applications:org.kde.dolphin.desktop,applications:org.kde.konsole.desktop,applications:systemsettings.desktop,applications:org.kde.discover.desktop</default>
    </entry>
  </group>
  <group name="Appearance">
    <!-- orb | ember | shelf | liquid -->
    <entry name="form" type="String"><default>orb</default></entry>
    <!-- docks: never | compact (small until hovered) | autohide (slides away, a line stays) -->
    <entry name="dockHide" type="String"><default>never</default></entry>
    <!-- bottom | left | right -->
    <entry name="dockEdge" type="String"><default>bottom</default></entry>
    <!-- primary | all | <screen name> -->
    <entry name="dockScreen" type="String"><default>primary</default></entry>
    <entry name="dockScale" type="Int"><default>100</default><min>60</min><max>160</max></entry>
    <entry name="shelfReflection" type="Bool"><default>true</default></entry>
    <!-- wallpaper, set from the settings centre: keep | flow | horizon | fogline -->
    <entry name="wallScene" type="String"><default>keep</default></entry>
    <entry name="wallPicker" type="String"><default>strips</default></entry>
    <entry name="wallFollow" type="Bool"><default>true</default></entry>
    <entry name="wallReact" type="String"><default>subtle</default></entry>
    <entry name="wallMotion" type="String"><default>normal</default></entry>
    <entry name="wallPause" type="Bool"><default>true</default></entry>
    <entry name="wallHour" type="Double"><default>17.5</default></entry>
    <!-- per-scene options as JSON, e.g. {"AuroraColor":"green"} -->
    <entry name="wallOpts" type="String"><default>{}</default></entry>
    <!-- login screen: auto (time of day) | desktop (same as the wallpaper) | a scene name -->
    <entry name="loginScene" type="String"><default>auto</default></entry>
    <!-- the load pill (org.pillbox.stats), mirrored here and written into the widget -->
    <entry name="statsStyle" type="String"><default>rings</default></entry>
    <entry name="clockPanel" type="String"><default>dashboard</default></entry>
    <!-- demo mode (tools/demo.sh): "ring" opens the ring, anything else closes it -->
    <entry name="demo" type="String"><default></default></entry>
    <!-- use the orb's colour as Plasma's accent colour for the whole system -->
    <entry name="systemAccent" type="Bool"><default>false</default></entry>
    <entry name="accentBefore" type="String"><default></default></entry>
    <!-- top bar arrangement: islands | bar | capsule -->
    <entry name="arrangement" type="String"><default>islands</default></entry>
    <!-- icon theme: keep (whatever was set) | Pillbox | Pillbox-Duo -->
    <entry name="iconTheme" type="String"><default>keep</default></entry>
    <entry name="iconThemeBefore" type="String"><default>breeze-dark</default></entry>
    <entry name="statsCpu" type="Bool"><default>true</default></entry>
    <entry name="statsGpu" type="Bool"><default>true</default></entry>
    <entry name="statsRam" type="Bool"><default>true</default></entry>
    <entry name="statsTemp" type="Bool"><default>true</default></entry>
    <entry name="ballScale" type="Int"><default>100</default><min>60</min><max>200</max></entry>
    <!-- "custom": use customColor, "system": the colour scheme's accent -->
    <entry name="colorMode" type="String"><default>custom</default></entry>
    <entry name="customColor" type="Color"><default>#8fb0c2</default></entry>
    <!-- aura | pulse | calm | plain -->
    <entry name="effect" type="String"><default>aura</default></entry>
    <!-- 50 = slow, 100 = normal, 200 = fast -->
    <entry name="effectSpeed" type="Int"><default>100</default><min>25</min><max>300</max></entry>
    <entry name="showSatellites" type="Bool"><default>true</default></entry>
    <entry name="ringIconSize" type="Int"><default>60</default><min>44</min><max>80</max></entry>
    <!-- scales the whole ring (distance, tiles, hub); independent of the ball size -->
    <entry name="ringScale" type="Int"><default>100</default><min>60</min><max>150</max></entry>
    <entry name="appColors" type="Bool"><default>true</default></entry>
    <!-- hide completely while an active fullscreen window covers the orb (games, video) -->
    <entry name="hideInFullscreen" type="Bool"><default>true</default></entry>
    <!-- fade to a faint "ghost" while a window lies under the orb; full again on hover -->
    <entry name="ghostOverWindows" type="Bool"><default>true</default></entry>
    <entry name="showBadges" type="Bool"><default>true</default></entry>
    <entry name="notificationRipple" type="Bool"><default>true</default></entry>
    <!-- JSON: appKey -> last time you looked at that app (ms) -->
    <entry name="notificationsSeen" type="String"><default>{}</default></entry>
  </group>
</kcfg>
